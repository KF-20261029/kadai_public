<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so101_policy</name>
  <version>0.0.0</version>
  <description>ROS 2 interface for the trained SO-101 pi0.5 policy.</description>
  <maintainer email="maintainers@example.invalid">SO-101 task contributors</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>message_filters</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mujoco_ros2_control_msgs</depend>
  <depend>trajectory_msgs</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
